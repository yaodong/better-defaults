# Global hotkeys. Apply edits with `skhd --restart-service`.
# Syntax: https://github.com/asmvik/skhd
#
# App launchers, mostly mirroring Omarchy's SUPER / SUPER+SHIFT defaults. Each one
# overrides the key in every app, including Ghostty's cmd+enter fullscreen.

# Launch or focus an app
cmd - return          : open -a Ghostty
cmd + shift - return  : open -a "Google Chrome"
cmd + shift - b       : open -a "Google Chrome"
cmd + shift - e       : open -a Gmail
cmd + shift - c       : open -a Calendar
cmd + shift - l       : open -a Slack
# 0x2C = slash
cmd + shift - 0x2C    : open -a 1Password

# Finder window at $HOME (activating Finder alone may show no window)
cmd + shift - f       : open ~
