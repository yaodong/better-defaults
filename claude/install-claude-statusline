#!/usr/bin/env python3
"""Ensure ~/.claude/settings.json contains required config. Idempotent."""

import json
import os
import tempfile

SETTINGS = os.path.expanduser("~/.claude/settings.json")
STATUSLINE_CMD = os.path.expanduser("~/.claude/statusline.sh")


def main():
    if os.path.exists(SETTINGS):
        with open(SETTINGS) as f:
            settings = json.load(f)
    else:
        settings = {}

    changed = []

    # Configure native statusLine (Claude Code's built-in status bar feature)
    desired = {"type": "command", "command": STATUSLINE_CMD}
    if settings.get("statusLine") != desired:
        settings["statusLine"] = desired
        changed.append(f"statusLine: {STATUSLINE_CMD}")

    # Atomic write
    dir_ = os.path.dirname(SETTINGS)
    os.makedirs(dir_, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=dir_, delete=False, suffix=".tmp") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
        tmp = f.name
    os.replace(tmp, SETTINGS)

    if changed:
        for entry in changed:
            print(f"Claude config: set {entry}")
    else:
        print("Claude config: already up to date.")


if __name__ == "__main__":
    main()
