#!/usr/bin/env bash
# Validate the local dev environment: tools installed, dotfiles linked,
# git/Claude/overcommit wired up. Reports only; run scripts/install or scripts/link
# to fix what's broken.

set -uo pipefail

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_FAIL=$'\033[31m'; C_WARN=$'\033[33m'; C_DIM=$'\033[2m'; C_RST=$'\033[0m'
else
  C_OK=""; C_FAIL=""; C_WARN=""; C_DIM=""; C_RST=""
fi

fails=0
warns=0

pass() { printf "  %s✓%s %s\n" "$C_OK" "$C_RST" "$1"; }
fail() { printf "  %s✗%s %s\n" "$C_FAIL" "$C_RST" "$1"; [ $# -ge 2 ] && printf "    %s%s%s\n" "$C_DIM" "$2" "$C_RST"; fails=$((fails+1)); }
warn() { printf "  %s!%s %s\n" "$C_WARN" "$C_RST" "$1"; [ $# -ge 2 ] && printf "    %s%s%s\n" "$C_DIM" "$2" "$C_RST"; warns=$((warns+1)); }
section() { printf "\n[%s]\n" "$1"; }

check_cmd() {
  local cmd="$1" hint="${2:-}"
  if command -v "$cmd" &>/dev/null; then
    pass "$cmd ($(command -v "$cmd"))"
  else
    fail "$cmd not found" "$hint"
  fi
}

check_link() {
  local dst="$1" expected_src="$BASE_DIR/$2"
  if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
    fail "$dst missing" "run ./scripts/link"
  elif [ ! -L "$dst" ]; then
    fail "$dst is not a symlink" "run ./scripts/link"
  else
    local actual; actual="$(readlink "$dst")"
    if [ "$actual" = "$expected_src" ]; then
      pass "$dst"
    else
      fail "$dst points to wrong target" "$actual (expected $expected_src)"
    fi
  fi
}

# --- Tools ---
section "Tools"
check_cmd brew "Run ./scripts/install"
check_cmd git
check_cmd nvim "brew install neovim"
check_cmd tmux "brew install tmux"
check_cmd starship "brew install starship"
check_cmd fzf "brew install fzf"
check_cmd rg "brew install ripgrep"

# --- Dotfile symlinks ---
section "Dotfile symlinks"
check_link "$HOME/.local/bin/theme-sync"     "bin/.local/bin/theme-sync"
check_link "$HOME/.claude/statusline.sh"     "claude/statusline.sh"
check_link "$HOME/.config/cursor"            "cursor"
check_link "$HOME/.config/ghostty"           "ghostty"
check_link "$HOME/.config/git/config"        "git/config"
check_link "$HOME/.config/git/ignore"        "git/ignore"
check_link "$HOME/.config/mise/config.toml"  "mise/config.toml"
check_link "$HOME/.ideavimrc"                "ideavim/.ideavimrc"
check_link "$HOME/.config/nvim"              "nvim"
check_link "$HOME/.config/starship.toml"     "starship/starship.toml"
check_link "$HOME/.config/tmux"              "tmux"
check_link "$HOME/.zshrc"                    "zsh/.zshrc"

# --- Git config (global) ---
section "Git"
git_name="$(git config user.name || true)"
if [ -n "$git_name" ]; then pass "user.name = $git_name"; else fail "user.name not set"; fi

# --- Git config (~/.setup) ---
section "Git (~/.setup)"
git_email="$(git -C "$BASE_DIR" config --local user.email || true)"
if [ "$git_email" = "yaodong.dev@gmail.com" ]; then pass "user.email = $git_email"; else warn "user.email = ${git_email:-<unset>} (expected yaodong.dev@gmail.com)" "run ./scripts/install to set repo-local email"; fi

# --- Overcommit ---
section "Overcommit"
if command -v overcommit &>/dev/null; then
  pre_commit="$BASE_DIR/.git/hooks/pre-commit"
  if [ -f "$pre_commit" ] && grep -q overcommit "$pre_commit" 2>/dev/null; then
    pass "hooks wired in this repo ($(overcommit --version 2>/dev/null))"
  else
    fail "hooks not wired in this repo" "run ./scripts/link"
  fi
else
  warn "overcommit not installed; skipping"
fi

# --- Claude Code ---
section "Claude Code"
claude_settings="$HOME/.claude/settings.json"
statusline_script="$HOME/.claude/statusline.sh"
if [ -f "$claude_settings" ] && command -v ruby &>/dev/null; then
  if ruby -rjson -e "
    s = JSON.parse(File.read('$claude_settings'))
    sl = s['statusLine']
    exit(sl && sl['type']=='command' && sl['command']=='$statusline_script' ? 0 : 1)
  " 2>/dev/null; then
    pass "statusLine configured"
  else
    fail "statusLine not configured" "run ./scripts/install-claude-statusline"
  fi
else
  warn "skipping Claude settings check ($claude_settings missing or ruby unavailable)"
fi

# --- Summary ---
section "Summary"
if [ "$fails" -eq 0 ] && [ "$warns" -eq 0 ]; then
  printf "  %sAll checks passed.%s\n" "$C_OK" "$C_RST"
  exit 0
elif [ "$fails" -eq 0 ]; then
  printf "  %s%d warning(s).%s\n" "$C_WARN" "$warns" "$C_RST"
  exit 0
else
  printf "  %s%d failure(s)%s, %s%d warning(s)%s.\n" "$C_FAIL" "$fails" "$C_RST" "$C_WARN" "$warns" "$C_RST"
  exit 1
fi
