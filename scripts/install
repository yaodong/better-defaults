#!/usr/bin/env bash

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

section() { printf "\n[%s]\n" "$1"; }

load_homebrew_env() {
  if command -v brew &>/dev/null; then
    return
  fi

  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

section "Homebrew"
if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  load_homebrew_env
else
  echo "Homebrew is installed"
fi

if ! command -v brew &>/dev/null; then
  echo "Error: Homebrew was installed but is not available on PATH." >&2
  exit 1
fi

echo "Installing packages from Brewfile..."
brew update
# Third-party taps (e.g. hashicorp/tap) require an explicit trust step since
# Homebrew 4.6; auto-trust the taps we declare so `brew bundle` doesn't halt.
for tap in hashicorp/tap asmvik/formulae; do
  brew trust "$tap" >/dev/null 2>&1 || true
done
brew bundle --file "$REPO_DIR/Brewfile"

section "Runtimes"
mise install --cd "$REPO_DIR"

section "Shell"
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  echo "Installing Oh My Zsh..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
else
  echo "Oh My Zsh already installed"
fi

section "Overcommit"
mise exec ruby -- gem install overcommit

section "Dotfiles"
"$REPO_DIR/scripts/link"

section "Git"
git -C "$REPO_DIR" config --local user.email "yaodong.dev@gmail.com"
echo "repo-local email set"

section "npm"
mkdir -p "$HOME/.npm-global/bin"
if command -v npm &>/dev/null; then
  npm config set prefix "$HOME/.npm-global"
elif ! grep -qxF "prefix=$HOME/.npm-global" "$HOME/.npmrc" 2>/dev/null; then
  # Append (don't clobber an existing ~/.npmrc that may hold registry/auth tokens).
  echo "prefix=$HOME/.npm-global" >>"$HOME/.npmrc"
fi
echo "global prefix configured"

section "Tmux"
if [ ! -d "$HOME/.config/tmux/plugins/tpm" ]; then
  echo "Installing TPM..."
  mkdir -p "$HOME/.config/tmux/plugins"
  git clone https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"
else
  echo "TPM already installed"
fi

section "skhd"
# Registers a launchd agent. skhd exits until it has Accessibility permission;
# launchd keeps retrying, so granting it later is enough.
skhd --restart-service >/dev/null 2>&1 || skhd --start-service
echo "skhd service registered; grant skhd Accessibility permission (System Settings > Privacy & Security > Accessibility)"

section "Claude Code"
mise exec python -- "$REPO_DIR/scripts/install-claude-statusline"

printf "\nSetup completed successfully!\n"
